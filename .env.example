# Copier en .env pour personnaliser (valeurs de démonstration, aucune donnée réelle).
# Jeton du backoffice : 12 caractères minimum. A changer hors poste local.
ADMIN_TOKEN=demo-admin-token-local
# Port hôte de la boutique (docker compose)
SHOP_HOST_PORT=13100
# Remise à zéro des données via POST /api/test/reset (recette uniquement)
ENABLE_TEST_RESET=true
