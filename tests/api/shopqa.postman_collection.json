{
  "info": {
    "name": "ShopQA - API boutique e-commerce",
    "description": "Campagne de tests API de la boutique de démonstration. Chaque requête porte la clé du cas de test Xray (SHOP-1xx) pour la traçabilité exigences <-> tests. Exécution : npm run test:api (Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Contrôles transverses appliqués à chaque requête métier (clé SHOP-xxx ; la préparation",
          "// est exclue du contrôle de temps car elle absorbe le démarrage à froid).",
          "if (/SHOP-\\d{3}/.test(pm.info.requestName)) {",
          "  pm.test('Temps de réponse < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
          "}",
          "if (pm.response.code !== 204) {",
          "  pm.test('Réponse au format JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Préparation",
      "description": "Remise à zéro du jeu de données de référence (JDD-CAT-01).",
      "item": [
        {
          "name": "Réinitialiser les données de test",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/test/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test",
                "reset"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Remise à zéro effectuée (204)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Catalogue",
      "description": "Exigences EX-CAT-01 à EX-CAT-03.",
      "item": [
        {
          "name": "SHOP-101 | Lister le catalogue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('8 produits du jeu de référence', () => pm.expect(products).to.have.lengthOf(8));",
                  "pm.test('Contrat : champs obligatoires et prix en centimes entiers', () => {",
                  "  products.forEach((p) => {",
                  "    pm.expect(p).to.include.all.keys('id', 'sku', 'name', 'category', 'priceCents', 'stock');",
                  "    pm.expect(Number.isInteger(p.priceCents) && p.priceCents > 0).to.be.true;",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "SHOP-102 | Filtrer par catégorie",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=high-tech",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "high-tech"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('Uniquement la catégorie high-tech', () => {",
                  "  pm.expect(products).to.have.lengthOf(2);",
                  "  products.forEach((p) => pm.expect(p.category).to.eql('high-tech'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
