{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["shop-demo/src/**/*.ts", "shop-demo/test/**/*.ts", "tests/e2e/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
